#!/usr/bin/env bash
# Compounded pre-push gate:
#  1) no private terms (kid names, private hosts) in outgoing commits
#  2) the kid-data preservation specs must pass
# Install with: npm run setup-hooks
set -euo pipefail

# One term per line, outside the repo and never tracked. A line may carry an
# optional matching mode:
#
#     <term>          substring match (the default, and the strict one)
#     <term>|word     whole-word match only
#
# SUBSTRING IS THE DEFAULT ON PURPOSE. A private term concatenated into a path,
# a hostname or an identifier is a real leak and whole-word matching would sail
# straight past all three. `|word` exists for a term that is also a substring of
# ordinary English, where substring matching produces only false positives.
#
# WHY THE MODE LIVES IN THE PRIVATE FILE AND NOT IN A TRACKED ALLOWLIST.
# An allowlist of "safe words" names the very words that contain a term, and a
# tracked comment explaining WHY a term needed one leaks its length, its
# occurrence count and the word family around it — enough to enumerate
# candidates from a public checkout and confirm one by its hit count. This file
# is never published, so putting the policy here means nothing public describes
# any term at all.
#
# NOTHING IN THIS REPOSITORY MAY CHARACTERISE A PRIVATE TERM. Not its length,
# not its shape, not how many times it occurs, not which words contain it, not
# why it needed a mode — in code, comments, docs, or commit messages. The term
# itself is never echoed by this hook either; a failure says only that one was
# found.
TERMS_FILE="$HOME/.config/compounded/private-terms"

if [ ! -f "$TERMS_FILE" ]; then
  echo "pre-push: missing $TERMS_FILE (one private term per line)." >&2
  echo "This gate fails closed — create the file, then push again." >&2
  exit 1
fi

# Match one term against a blob of text, honouring its mode.
matches() { # $1 = term, $2 = mode, stdin = text
  if [ "$2" = word ]; then grep -qiwF -- "$1"; else grep -qiF -- "$1"; fi
}

ZERO=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue # branch deletion

  # A brand-new remote branch has no remote_sha. The old code passed the
  # all-zeros SHA straight to `git diff` with 2>/dev/null, so the diff scan
  # FAILED SILENTLY and every added line went unchecked on exactly the push
  # that publishes a branch for the first time. Use the empty tree instead.
  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha"
    base=$(git hash-object -t tree /dev/null)
  else
    range="$remote_sha..$local_sha"
    base="$remote_sha"
  fi

  msgs=$(git log --format='%B' "$range")

  # PER-COMMIT, NOT THE NET DIFF. This scanned `git diff base..head` only, which
  # cannot see content that was ADDED AND THEN REMOVED inside the pushed range —
  # yet every one of those commits is published and the blob stays reachable
  # forever. That is not hypothetical: a `node_modules` symlink pointing at a
  # home directory was added in one commit and deleted in the next, and went
  # public because the net diff showed nothing. Scanning each commit's own diff
  # closes it. `-M` keeps renames cheap; `--no-textconv` avoids running filters.
  added=$(git log --format='%n' -p -M --no-textconv "$range" | grep '^+' || true)

  # Symlinks are the other half of that hole: `grep -r` will not read a symlink
  # and `git grep` skips them, so a symlink whose TARGET is a private path is
  # invisible to a tree scan. Collect their targets explicitly.
  links=""
  for c in $(git rev-list "$range"); do
    while read -r mode _type sha _path; do
      [ "$mode" = 120000 ] || continue
      links="$links
$(git cat-file blob "$sha" 2>/dev/null || true)"
    done < <(git ls-tree -r "$c" 2>/dev/null | grep '^120000 ' || true)
  done

  while IFS= read -r line; do
    [ -z "$line" ] && continue
    term="${line%%|*}"
    mode="word"; [ "$line" = "$term" ] && mode="substring"
    [ -z "$term" ] && continue

    if matches "$term" "$mode" <<< "$msgs"; then
      echo "pre-push: a private term appears in an outgoing COMMIT MESSAGE ($range)." >&2
      echo "Reword the commit before pushing (the term itself is not echoed here)." >&2
      exit 1
    fi
    if matches "$term" "$mode" <<< "$added"; then
      echo "pre-push: a private term appears in ADDED lines of an outgoing COMMIT ($range)." >&2
      echo "Redact it before pushing (the term itself is not echoed here)." >&2
      exit 1
    fi
    if [ -n "$links" ] && matches "$term" "$mode" <<< "$links"; then
      echo "pre-push: a private term appears in a SYMLINK TARGET in an outgoing commit ($range)." >&2
      echo "Remove the symlink before pushing (the term itself is not echoed here)." >&2
      exit 1
    fi
  done < "$TERMS_FILE"
done

# THE TEST BELOW USES A HERESTRING, NOT A PIPE, AND THAT IS LOAD-BEARING — see
# `matches` above. This gate previously read `git log … | grep -qiF -- "$term"`.
# Under `set -o pipefail` that construction FAILS OPEN: `grep -q` exits the
# instant it matches, the upstream writer takes SIGPIPE, pipefail turns the whole
# pipeline non-zero, and `if` reads non-zero as "no match" — so a detected leak
# is reported clean. It only bites when the match happens early enough that the
# writer still has output buffered, which means the gate was reliable for a term
# buried deep in history and silently useless for one in the most recent
# commits. Do not turn these back into pipes.

echo "pre-push: private-term scan clean; running preservation specs…"
npm run build >/dev/null 2>&1
npx playwright test tests/migration.spec.js tests/synctrust.spec.js
