# Copy to deploy/.env (gitignored). The family key protects /sync/profiles/.
# Generate a strong one (>=128 bits of entropy):
#   openssl rand -base64 24
SYNC_KEY=

# The Docker network your TLS proxy (traefik) lives on — REQUIRED, the
# web container attaches to it. Find yours with: docker network ls
TRAEFIK_NETWORK=your-proxy-network
